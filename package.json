{
  "name": "3d-zone-slicer-api",
  "version": "1.0.0",
  "description": "REST API for 3D zone slicer processing with Blender",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "docker:create-network": "docker network create qaztwin-ssap-dev-net",
