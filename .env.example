# Network Configuration
COMPOSE_NETWORK_NAME=qaztwin-ssap-dev-net

# Environment Configuration
NODE_ENV=production

# Server Configuration
PORT=4103

# Application Settings
NODE_ENV=production

# Base directory for input/output files (mounted volume)
BASE_DIR=./data

# Processing timeout in milliseconds (default 300000 = 5 minutes)
PROCESS_TIMEOUT_MS=300000

# Lock timeout in milliseconds (default 600000 = 10 minutes)
LOCK_TIMEOUT_MS=600000